# nucleo-api · UN solo .env local con las 2 URIs de Atlas (no uses localhost)
# No subir secretos reales al git.
# Producción Render (Parienta): ver deploy/RENDER-PARIENTA.env.example y DEPLOY-MANUAL.md

# ── Compartido (keys IA) ────────────────────────────────────
NARA_MS_HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
N8N_TEO_WEBHOOK=
N8N_WEBHOOK_SECRET=

# ── Parienta (local) → http://127.0.0.1:4000 ────────────────
# Prefijos PARIENTA_* o PLATEADO_* (legado). run-dev.mjs los aplana a MONGODB_URI etc.
PARIENTA_MONGODB_URI=mongodb+srv://USER:PASS@cluster/...
PARIENTA_MONGODB_DB=nucleo_parienta
PARIENTA_AUTH_SECRET=cambiar-secreto-parienta
PLATEADO_MONGODB_URI=mongodb+srv://USER:PASS@cluster/...
PLATEADO_MONGODB_DB=nucleo_parienta
PLATEADO_AUTH_SECRET=cambiar-secreto-parienta
PLATEADO_GATEWAY_PORT=4000
PLATEADO_AUTH_PORT=4001
PLATEADO_PEOPLE_PORT=4002
PLATEADO_OPS_PORT=4003
PLATEADO_AI_PORT=4004
PLATEADO_CORS_ORIGIN=http://localhost:3003,http://127.0.0.1:3003

# ── NARA (local, otra instancia) → http://127.0.0.1:4100 ────
NARA_MONGODB_URI=mongodb+srv://USER:PASS@cluster-nara/...
NARA_MONGODB_DB=nara
NARA_AUTH_SECRET=cambiar-secreto-nara
NARA_GATEWAY_PORT=4100
NARA_AUTH_PORT=4101
NARA_PEOPLE_PORT=4102
NARA_OPS_PORT=4103
NARA_AI_PORT=4104
NARA_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
