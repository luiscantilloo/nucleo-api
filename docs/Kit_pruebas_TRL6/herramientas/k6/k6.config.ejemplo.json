{
  "_nota": "Copiar a k6.config.json y llenar. Sin claves: cada clave va en -e PASS_<ROL>=... al correr k6.",
  "ingreso": {
    "ruta": "/api/auth/login",
    "cuerpo": { "email": "{email}", "password": "{password}" },
    "sesion": "cookie",
    "campoToken": "token"
  },
  "cabecerasDeMitigacion": ["x-vercel-mitigated", "cf-mitigated"],
  "roles": {
    "admin":    { "email": "prueba.admin@ejemplo.com",    "peso": 1,  "rutas": ["/api/auth/me", "/api/usuarios"] },
    "operador": { "email": "prueba.operador@ejemplo.com", "peso": 10, "rutas": ["/api/auth/me", "/api/registros"] },
    "usuario":  { "email": "prueba.usuario@ejemplo.com",  "peso": 50, "rutas": ["/api/auth/me", "/api/mis-datos"] }
  },
  "soak": { "rol": "operador" }
}
