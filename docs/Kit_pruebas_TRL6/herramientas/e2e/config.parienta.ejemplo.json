    }
  },
  "roles": [
    { "id": "admin", "email": "1.admin.prueba@test.com", "inicio": "/inicio" },
    { "id": "admin2", "email": "1b.admin2.prueba@test.com", "inicio": "/inicio" },
    { "id": "experto", "email": "2.experto.prueba@test.com", "inicio": "/experto" },
    { "id": "clinico", "email": "3.clinico.prueba@test.com", "inicio": "/clinico" },
    { "id": "paciente", "email": "4.paciente.prueba@test.com", "inicio": "/paciente" },
    { "id": "paciente2", "email": "4b.paciente2.prueba@test.com", "inicio": "/paciente" },
    { "id": "observador", "email": "5.observador.prueba@test.com", "inicio": "/observador" }
  ],
  "rutaSesion": "/api/auth/me",
  "rutasProtegidas": ["/api/accounts", "/api/patients"],
  "cabecerasEsperadas": ["strict-transport-security", "x-content-type-options"]
