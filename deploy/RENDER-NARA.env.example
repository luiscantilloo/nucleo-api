# Pegar en Render → Environment (servicio Web NARA del núcleo).
# Mismo repo que Parienta; OTRA instancia / otro servicio.
# NO mezclar con PROGRAM_ID=parienta ni con la DB de Parienta.

PROGRAM_ID=nara
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/nara?retryWrites=true&w=majority
MONGODB_DB=nara
AUTH_SECRET=mismo-o-nuevo-secreto-nara
CORS_ORIGIN=https://TU-NARA.vercel.app,http://localhost:3000,http://localhost:3002

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
N8N_TEO_WEBHOOK=
N8N_WEBHOOK_SECRET=

NARA_AUTH_PORT=4001
NARA_PEOPLE_PORT=4002
NARA_OPS_PORT=4003
NARA_AI_PORT=4004
NARA_MS_HOST=127.0.0.1
AUTH_ALLOW_LEGACY_TOKENS=0
