# Pegar en Render → Environment (servicio Web Parienta).
# NO subir secretos reales al git. Sustituir valores.

PROGRAM_ID=parienta
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/nucleo_parienta?retryWrites=true&w=majority
MONGODB_DB=nucleo_parienta
AUTH_SECRET=generar-secreto-largo-aleatorio
CORS_ORIGIN=https://TU-PROYECTO-PARIENTA.vercel.app,http://localhost:3003

# Opcional IA / n8n (si Parienta usa TEO en prod)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
N8N_TEO_WEBHOOK=
N8N_WEBHOOK_SECRET=

# Render inyecta PORT; no hace falta fijarlo.
# Microservicios internos (mismo contenedor):
NARA_AUTH_PORT=4001
NARA_PEOPLE_PORT=4002
NARA_OPS_PORT=4003
NARA_AI_PORT=4004
NARA_MS_HOST=127.0.0.1

# Producción: rechazar tokens legado de 3 partes
AUTH_ALLOW_LEGACY_TOKENS=0
