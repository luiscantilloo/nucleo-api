# Pegar en Render → Environment (servicio Web QUINTIA del núcleo, instancia única).
# Mismo repo que Parienta/NARA; OTRA instancia / otro servicio si no usas el proxy triple.
# NO mezclar con PROGRAM_ID=parienta|nara ni con sus bases.

PROGRAM_ID=quintia
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/nucleo_consiente?retryWrites=true&w=majority
# Por defecto local/scripts: nucleo_consiente. Alternativa: nucleo_quintia (misma variable en todo el stack)
MONGODB_DB=nucleo_consiente
AUTH_SECRET=mismo-o-nuevo-secreto-quintia
CORS_ORIGIN=https://TU-QUINTIA.vercel.app,http://localhost:3004

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
N8N_TEO_WEBHOOK=
N8N_WEBHOOK_SECRET=

QUINTIA_AUTH_PORT=4201
QUINTIA_PEOPLE_PORT=4202
QUINTIA_OPS_PORT=4203
QUINTIA_AI_PORT=4204
NARA_MS_HOST=127.0.0.1
AUTH_ALLOW_LEGACY_TOKENS=0

# Render: el proceso escucha en 0.0.0.0:$PORT (start-prod + proxy o stack único).
