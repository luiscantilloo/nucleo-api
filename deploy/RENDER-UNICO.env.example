# UN solo Web Service en Render = nucleo-api con 2 o 3 bases.
# Build: npm ci && npm run build
# Start: npm run start:prod

# ── Parienta ──
PARIENTA_MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/...
PARIENTA_MONGODB_DB=nucleo_parienta
PARIENTA_AUTH_SECRET=secreto-parienta
PARIENTA_CORS_ORIGIN=https://TU-PARIENTA.vercel.app,http://localhost:3003

# ── NARA ──
NARA_MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/...
NARA_MONGODB_DB=nara
NARA_AUTH_SECRET=secreto-nara
NARA_CORS_ORIGIN=https://TU-NARA.vercel.app,http://localhost:3000,http://localhost:3002

# ── QUINTIA (opcional → modo triple) ──
QUINTIA_MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/...
QUINTIA_MONGODB_DB=nucleo_consiente
QUINTIA_AUTH_SECRET=secreto-quintia
QUINTIA_CORS_ORIGIN=https://TU-QUINTIA.vercel.app,http://localhost:3004

# ── Compartido ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
N8N_TEO_WEBHOOK=
N8N_WEBHOOK_SECRET=
AUTH_ALLOW_LEGACY_TOKENS=0

# PORT lo pone Render. Modo dual si hay PARIENTA_+NARA_; triple si también QUINTIA_.
