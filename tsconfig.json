{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@nara/common": ["libs/common/src"],
      "@nara/common/*": ["libs/common/src/*"],
      "@nara/database": ["libs/database/src"],
      "@nara/database/*": ["libs/database/src/*"],
      "@nara/auth-core": ["libs/auth-core/src"],
      "@nara/auth-core/*": ["libs/auth-core/src/*"],
      "@nara/ai": ["libs/ai/src"],
      "@nara/ai/*": ["libs/ai/src/*"],
      "@nucleo/program": ["libs/program/src"],
      "@nucleo/program/*": ["libs/program/src/*"],
      "@nucleo/crisis": ["libs/crisis/src"],
      "@nucleo/crisis/*": ["libs/crisis/src/*"],
      "@nucleo/reglas": ["libs/reglas/src"],
      "@nucleo/reglas/*": ["libs/reglas/src/*"],
      "@nucleo/privacidad": ["libs/privacidad/src"],
      "@nucleo/privacidad/*": ["libs/privacidad/src/*"]
    }
  }
}
